# --- API Keys ---
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Where to save audio/transcripts/notes.
# Leave empty to use the script's own folder by default.
STUDYNOTES_DIR=

# Model selection for transcription and summarization.
# "auto" lets the app pick/fallback automatically between providers.
TRANSCRIBE_MODEL_CHOICE=auto
SUMMARY_MODEL_CHOICE=auto
